<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="BomAuthoring.uss" />
  <ui:VisualElement class="bom-root">
    <ui:Label text="BOM authoring" class="bom-title" />
    <ui:VisualElement name="toolbar" class="bom-toolbar" />
    <ui:VisualElement name="workbench" class="bom-workbench bom-narrow">
      <ui:VisualElement name="visuals" class="bom-visuals bom-hidden" />
      <ui:ScrollView name="content" class="bom-content" />
    </ui:VisualElement>
    <ui:VisualElement name="footer" class="bom-footer bom-hidden" />
    <ui:Label name="status" class="bom-report" />
  </ui:VisualElement>
</ui:UXML>
